# Ignore all files
*

# Except these:
# README, license, and preview image
!README.md
!LICENSE
!.setup-unix.png

# config files/folders
!.gitignore
!.gitignore_global
!.gitconfig
!.gitmodules

!.bash_profile
!.bash_profile.darwin.sh
!.bashrc
!.bashrc_skip_tmux
!.bash_color_prompt.sh
!.bash_aliases
!.lessfilter
!.git-prompt-colors.sh
!.inputrc

!.tmux.conf
!.tmux.darwin.conf

!.vim
!.vimrc
!.config/
.config/*
!.config/nvim/
!.config/git/config
!.config/git/config.github.CoeJoder

!.local/
.local/*
!.local/bin/
.local/bin/*
!.local/bin/n

!.n
!.avn
!.avnrc
!.node-version

!.npmrc
!.npmrcs/
.npmrcs/*
!.npmrcs/default

!.npm_global

# track specific scripts
!scripts
scripts/*
!scripts/vm.sh
!scripts/deploy_setup_unix.sh

!.ssh
.ssh/*
!.ssh/rc

